    "Example 1:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8883142e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "\n",
    "image = cv2.imread(\""D:/open cv/Feature Detection and Description/babarazam.jpeg"\")\n",
    "\n",
    "border_reflect = cv2.copyMakeBorder(image, 50, 50, 50, 50, cv2.BORDER_REFLECT)\n",
    "border_reflect_101 = cv2.copyMakeBorder(image, 50, 50, 50, 50, cv2.BORDER_REFLECT_101)\n",
    "border_replicate = cv2.copyMakeBorder(image, 50, 50, 50, 50, cv2.BORDER_REPLICATE)\n",
    "\n",
    "cv2.imshow(\"Border Reflect\", border_reflect)\n",
    "cv2.imshow(\"Border Reflect 101\", border_reflect_101)\n",
    "cv2.imshow(\"Border Replicate\", border_replicate)\n",
    "\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
  },
