   "source": [
    "Building a Gaussian Pyramid "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "272a5e8e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Pyramid Level 3\n",
      "Pyramid Level 2\n",
      "Pyramid Level 1\n",
      "Pyramid Level 0\n"
     ]
    }
   ],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "\n",
    "image = cv2.imread(\""D:/open cv/Feature Detection and Description/babarazam.jpeg"\")\n",
    "\n",
    "pyramid = [image]\n",
    "\n",
    "for i in range(3):\n",
    "    image = cv2.pyrDown(image)\n",
    "    pyramid.append(image)\n",
    "\n",
    "for i in range(len(pyramid)-1, -1, -1):\n",
    "    print(f\"Pyramid Level {i}\")\n",
    "    cv2.imshow(f\"Pyramid Level {i}\", pyramid[i])\n",
    "    cv2.waitKey(0)\n",
    "\n",
    "cv2.destroyAllWindows()"
   ]
  }
