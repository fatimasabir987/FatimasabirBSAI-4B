   "source": [
    "Example 1: Convert BGR to Grayscale\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1ac7a873",
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "src = cv2.imread(r\""D:/open cv/Feature Detection and Description/babarazam.jpeg"\")  \n",
    "\n",
    "gray_image = cv2.cvtColor(src, cv2.COLOR_BGR2GRAY)\n",
    "\n",
    "cv2.imshow(\"Grayscale Image\", gray_image)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "13994548",
   "metadata": {},
   "source": [
    "Example 2: Convert BGR to HSV"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e916d449",
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "src = cv2.imread(r\""D:/open cv/Feature Detection and Description/babarazam.jpeg"\")\n",
    "\n",
    "# Convert to HSV\n",
    "hsv_image = cv2.cvtColor(src, cv2.COLOR_BGR2HSV)\n",
    "\n",
    "cv2.imshow(\"HSV Image\", hsv_image)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4fe724fb",
   "metadata": {},
   "source": [
    "Example 3: Convert BGR to RGB (For Matplotlib)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "15680784",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "src = cv2.imread(r\""D:/open cv/Feature Detection and Description/babarazam.jpeg"\")\n",
    "\n",
    "# Convert from BGR to RGB\n",
    "rgb_image = cv2.cvtColor(src, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "# Display with Matplotlib\n",
    "plt.imshow(rgb_image)\n",
    "plt.title(\"RGB Image for Matplotlib\")\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
  }
