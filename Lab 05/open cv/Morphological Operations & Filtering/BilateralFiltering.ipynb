    "import cv2\n",
    "import os\n",
    "\n",
    "path = r\"D:\\open cv\\Morphological Operations & Filtering\\taj.jpg\"\n",
    "\n",
    "print(\"File Exists:\", os.path.exists(path))\n",
    "\n",
    "img = cv2.imread(path)\n",
    "\n",
    "if img is None:\n",
    "    print(\"Image not loaded. Check path again.\")\n",
    "else:\n",
    "    bilateral = cv2.bilateralFilter(img, 15, 75, 75)\n",
    "    cv2.imwrite(\"taj_bilateral.jpg\", bilateral)\n",
    "    print(\"Image processed successfully!\")"
   ]
  },
